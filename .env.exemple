# Carte live Meshtastic — configuration minimale.
# Tout le reste se règle depuis la carte (assistant d'installation, puis Réglages).

# Code d'installation : s'il est rempli, il est demandé pour créer le compte administrateur.
# Laissé vide, l'installation n'est possible que depuis le réseau local.
ADMIN_MOT_DE_PASSE=

# Port de la carte sur la machine
CARTE_PORT=8095

# Broker MQTT (modifiable dans l'assistant)
MQTT_URL=mqtt://mqtt.exemple.fr:1883
MQTT_UTILISATEUR=
MQTT_MOT_DE_PASSE=
MQTT_RACINE=msh/EU_868

# Canaux à déchiffrer : nom=clé (AQ== = clé publique par défaut), séparés par ;
CANAUX=LongFast=AQ==

# MeshCore (carte, analyseur de paquets, companion observateur)
# MESHCORE=non pour désactiver ; sujets au format meshcoretomqtt : RACINE/IATA/CLÉ/packets
MESHCORE=oui
MESHCORE_RACINE=meshcore
MESHCORE_IATA=LPY
MESHCORE_REPUBLIER=oui
# Canaux à déchiffrer : Public ; #nom (canal hashtag) ; nom=secret (32 caractères hexadécimaux)
MESHCORE_CANAUX=Public

# Module Meshtastic en Wi-Fi (facultatif, aussi réglable depuis la carte : Réseau › Modules radio)
RADIO_HOTE=
RADIO_PORT=4403
