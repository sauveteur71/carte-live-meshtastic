# Carte live Meshtastic — configuration minimale.
# Tout le reste se règle depuis la carte (assistant d'installation, puis Réglages).

# Code d'installation (facultatif) : demandé pour créer le compte administrateur.
# Laissé vide : depuis le réseau local, aucun code n'est demandé ; depuis ailleurs (serveur distant,
# proxy inversé, Tailscale…), un code est tiré au hasard et affiché dans le journal du serveur :
#   docker compose logs carte-live | grep -i installation
ADMIN_MOT_DE_PASSE=

# Port de la carte sur la machine
CARTE_PORT=8095

# Affichage par défaut (chaque visiteur peut changer de fond et de couches ; son choix est gardé)
# Fond : sombre, plan, plan-sombre, photos ou topo
CARTE_FOND=sombre
# Réseaux proposés : les-deux, meshtastic ou meshcore (masque le choix et l'autre réseau)
CARTE_RESEAUX=les-deux
# Couches masquées au départ, séparées par des virgules : sommets (points hauts et sites proposés),
# routiers, rf, voisinage, traceroute, animations, federation, releves
CARTE_COUCHES_MASQUEES=

# Broker MQTT (modifiable dans l'assistant)
MQTT_URL=mqtt://mqtt.exemple.fr:1883
MQTT_UTILISATEUR=
MQTT_MOT_DE_PASSE=
MQTT_RACINE=msh/EU_868
# Brokers écoutés en plus (jusqu'à 5) : « adresse » ou « adresse|racine », séparés par des virgules ;
# identifiant et mot de passe dans l'adresse. Les paquets reçus en double par deux brokers sont ignorés.
# MQTT_BROKERS_SUPPLEMENTAIRES=mqtts://nom:motdepasse@mqtt.voisin.fr:8883|msh/EU_868/FR

# Canaux à déchiffrer : nom=clé (AQ== = clé publique par défaut), séparés par ;
CANAUX=LongFast=AQ==

# MeshCore (carte, analyseur de paquets, companion observateur)
# MESHCORE=non pour désactiver ; sujets au format meshcoretomqtt : RACINE/IATA/CLÉ/packets
MESHCORE=oui
MESHCORE_RACINE=meshcore
MESHCORE_IATA=LPY
MESHCORE_REPUBLIER=oui
# Canaux à déchiffrer : Public ; #nom (canal hashtag) ; nom=secret (32 caractères hexadécimaux)
MESHCORE_CANAUX=Public
# Réglage radio attendu du companion : fréquence,bande,SF,CR (réseau français par défaut) ; « non » : pas d'avertissement
MESHCORE_RADIO_ATTENDUE=869.618,62.5,8,8
# Régions MeshCore supplémentaires à reconnaître dans les messages (eu, fr, fr-ara, fr-43… sont déjà connues)
MESHCORE_REGIONS=
# Répéteur muet au-delà de (heures) ; état des répéteurs interrogé toutes les N heures (0 = jamais), N max. par tour
MESHCORE_MUET_HEURES=26
# Paquets et réceptions MeshCore conservés N jours (le flux national est très volumineux)
MESHCORE_RETENTION_PAQUETS_JOURS=2
# Paquets MeshCore conservés : departement, voisins (département + limitrophes) ou national (très lourd)
MESHCORE_PERIMETRE=voisins
# Liaisons MeshCore déduites des chemins : taille minimale des hachages (1, 2 ou 3 octets ; 1 octet = préfixes ambigus)
MESHCORE_LIENS_OCTETS_MIN=2
# Codes de zone acceptés pour les observateurs sans position (ex. CFE,LYS,EBU)
MESHCORE_IATA_VOISINS=
# Exports (GeoJSON, GPX, Prometheus /metrics, Home Assistant) : si défini, ?jeton=… est exigé
EXPORT_JETON=
MESHCORE_SUPERVISION_HEURES=3
MESHCORE_SUPERVISION_MAX=8

# Module Meshtastic en Wi-Fi (facultatif, aussi réglable depuis la carte : Réseau › Modules radio)
RADIO_HOTE=
RADIO_PORT=4403

# mqtts:// ou wss:// avec certificat auto-signé uniquement : désactive la vérification du certificat (déconseillé)
# MQTT_TLS_NON_VERIFIE=oui
# Proxys inversés autorisés à transmettre l'adresse du visiteur (défaut : adresses locales, ex. proxy inversé DSM)
# PROXY_CONFIANCE=loopback, linklocal, uniquelocal

# Archive PostgreSQL (facultative) : tout le trafic recopié sans limite de durée (Grafana, requêtes SQL…).
# Avec le conteneur fourni : docker compose --profile postgres up -d
# POSTGRES_MOT_DE_PASSE=un-mot-de-passe-long
# POSTGRES_URL=postgres://carte:un-mot-de-passe-long@postgres:5432/carte

# Passerelle inter-réseaux Meshtastic ⇄ MeshCore (messages de canal, outil d'appoint) : un administrateur l'active
# dans Outils › ⇄ Passerelle inter-réseaux. PASSERELLE=1 : activée dès le premier démarrage ; PASSERELLE=0 : interdite.
# PASSERELLE=1

# Paquet « relief France » (Gestion › Réglages › Préparer toute la France) : autre adresse que la version GitHub relief-france
# RELIEF_FRANCE_URL=https://github.com/sauveteur71/carte-live-meshtastic/releases/download/relief-france/relief-france.tar.gz
# Relief approximatif du monde entier (NOAA ETOPO1 à 5′ ≈ 9 km, 19 Mo, téléchargé une fois) affiché, marqué « approximatif »,
# le temps que le relief IGN d'un département se télécharge. Désactivé par défaut (Outils › Toute la France pour l'activer).
# RELIEF_MONDE=oui
# RELIEF_MONDE_MINUTES=5          # pas de la grille en minutes d'arc (3 = ≈ 5,5 km, 52 Mo sur le disque)
# RELIEF_MONDE_ERDDAP=https://coastwatch.pfeg.noaa.gov/erddap,https://cwcgom.aoml.noaa.gov/erddap

# Bandeau anglais « Switch to the world map » proposé aux visiteurs dont le navigateur n'est pas en français (carte et
# page publique). Désactivé par défaut ; réglable aussi dans Réglages › Réglages avancés › Affichage.
# BANDEAU_MONDE=oui
# BANDEAU_MONDE_URL=https://github.com/sauveteur71/live-mesh-map-world   # adresse ouverte (http/https) ; vide = édition monde sur GitHub

# Mur des donateurs (Outils › Carte publique et exports › Mur des donateurs) : bandeau discret remerciant ceux qui soutiennent
# le projet. Tout est désactivé par défaut ; les mêmes réglages se font depuis la carte (enregistrés alors dans
# /data/donateurs.json, qui prime sur ce fichier). Clés et jetons ne sont jamais réaffichés ni écrits dans le journal.
# HelloAsso : HelloAsso ne dit pas si un donateur accepte d'être affiché, donc aucun don n'apparaît automatiquement : chaque
# entrée est saisie par l'administrateur avec l'accord du donateur. Les identifiants d'API (https://admin.helloasso.com,
# rubrique API) servent seulement à vérifier l'accès au formulaire.
# HELLOASSO_ACTIF=oui
# HELLOASSO_CLIENT_ID=
# HELLOASSO_CLIENT_SECRET=
# HELLOASSO_ORGANISATION=radioclub-du-velay   # nom de l'association dans l'adresse HelloAsso
# HELLOASSO_FORMULAIRE=2                      # identifiant du formulaire de don (fin de son adresse)
# HELLOASSO_TYPE=Donation                    # type du formulaire : Donation, CrowdFunding, Membership, Event, PaymentForm, Checkout, Shop
# GitHub Sponsors : seuls les sponsors marqués publics par GitHub sont affichés. Jeton à lecture seule (read:user suffit).
# GITHUB_SPONSORS_ACTIF=oui
# GITHUB_SPONSORS_JETON=
# GITHUB_SPONSORS_COMPTE=sauveteur71
# DONATEURS_INTERVALLE_HEURES=1               # relecture des sources (1 à 24 h)

# Fonctions masquées pour tous les utilisateurs (modifiable ensuite dans Réglages › Fonctions affichées) :
# signalements, vigipirate, fr-alert, main-courante, bipper. Ex. pour ne garder que la vigilance météo :
# FONCTIONS_MASQUEES=signalements,vigipirate,fr-alert,main-courante,bipper

# Feux actifs : NASA FIRMS est lu sans compte. Pour ajouter Meteosat (détection toutes les 15 min, pixel ~4 km),
# créez un compte gratuit sur https://mokey.lsasvcs.ipma.pt/auth/signup (LSA SAF, EUMETSAT) et renseignez-le ici.
LSASAF_UTILISATEUR=
LSASAF_MOT_DE_PASSE=

# Langue du journal du serveur (docker compose logs) : fr ou en. L'interface suit la langue de chaque navigateur.
# LANGUE=fr

# ---- Winlink (section ADRASEC, facultatif) ----
# Pat, client Winlink, lancé avec : docker compose --profile winlink up -d
# PAT_URL=http://pat:8080
# Indicatif de la station Winlink, affiché dans la section (le mot de passe reste dans Pat)
# PAT_INDICATIF=F4ABC
